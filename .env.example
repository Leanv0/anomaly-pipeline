# Credenciales del object storage (RustFS / S3-compatible)
# Copiá este archivo a .env y completá con tus valores:
#   cp .env.example .env
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tu_access_key
STORAGE_SECRET_KEY=tu_secret_key

# Base de datos relacional (PostgreSQL para alertas y métricas)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=anomaly_user
POSTGRES_PASSWORD=tu_contrasena_postgres
POSTGRES_DB=anomaly_db

# Dashboard de visualización (Grafana)
GRAFANA_ADMIN_USER=tu_usuario_grafana
GRAFANA_ADMIN_PASSWORD=tu_contrasena_segura_grafana
