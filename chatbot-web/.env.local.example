# ============================================================
# Variables de entorno para el Chatbot del Anomaly Pipeline
# Copiar este archivo como .env.local y completar los valores.
# ============================================================

# API Key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a utilizar (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Conexión a PostgreSQL
# Local (Docker):
POSTGRES_URL=postgresql://anomaly_user:tu_password@localhost:5432/anomaly_db

# Nube (Neon, Supabase, etc.):
# POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Habilitar SSL para PostgreSQL (true para proveedores cloud, false para Docker local)
POSTGRES_SSL=false
